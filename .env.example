# Optional. Most public Play Limitless endpoints work without a key.
LIMITLESS_API_KEY=

# Japan City League uses scheduled polling; Play Limitless webhooks do not
# cover these events. The Docker scheduler runs immediately, then at this interval.
JP_SYNC_INTERVAL_HOURS=24
JP_SYNC_PAGES=10
JP_SYNC_MAX_EVENTS=100

# Checks the Labs event list every six hours and adds completed, usable
# Regionals and Special Events for the 2027 season to the persistent catalog.
SEASON_SYNC_INTERVAL_HOURS=6
