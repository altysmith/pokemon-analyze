# Optional. Public tournament endpoints do not require a key.
# A key is only needed for protected endpoints such as deck classification rules.
LIMITLESS_API_KEY=

# Japan City League uses scheduled polling; Play Limitless webhooks do not
# cover these events. The Docker scheduler runs immediately, then at this interval.
JP_SYNC_INTERVAL_HOURS=24
JP_SYNC_PAGES=1
JP_SYNC_MAX_EVENTS=10
