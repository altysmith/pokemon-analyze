# Optional. Most public Play Limitless endpoints work without a key.
LIMITLESS_API_KEY=

# Japan City League uses scheduled polling; Play Limitless webhooks do not
# cover these events. The Docker scheduler runs immediately, then daily at
# 11:00 AM Eastern. The named time zone follows daylight-saving changes.
JP_SYNC_TIME_ZONE=America/New_York
JP_SYNC_HOUR=11
JP_SYNC_MINUTE=0
JP_SYNC_PAGES=10
JP_SYNC_MAX_EVENTS=100
